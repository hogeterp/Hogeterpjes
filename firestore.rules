rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'rohogeterp@gmail.com';
    }
    function isInvited() {
      return request.auth != null &&
        request.auth.token.email in get(/databases/$(database)/documents/appAdmin/settings).data.allowedEmails;
    }
    function isRinzeOrChrista() {
      return request.auth != null && (
        isAdmin() ||
        get(/databases/$(database)/documents/profielen/$(request.auth.uid)).data.displayName == 'Christa'
      );
    }
    match /appAdmin/settings {
      allow read: if isInvited() || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /appData/hogeterpjes {
      allow read, write: if isInvited() || isAdmin();
    }
    match /profielen/{userId} {
      allow read: if request.auth != null && ((request.auth.uid == userId && (isInvited() || isAdmin())) || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId && (isInvited() || isAdmin());
    }
    match /vaults/rinze-christa {
      allow read: if isRinzeOrChrista();
      allow create, update, delete: if isAdmin();
      match /files/{fileId} {
        allow read, create, update, delete: if isRinzeOrChrista();
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
