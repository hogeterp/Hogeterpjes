rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'rohogeterp@gmail.com';
    }
    function settings() {
      return get(/databases/$(database)/documents/appAdmin/settings).data;
    }
    function isInvited() {
      return signedIn() && request.auth.token.email in settings().allowedEmails;
    }
    function profileName() {
      return get(/databases/$(database)/documents/profielen/$(request.auth.uid)).data.displayName;
    }
    function isRinzeOrChrista() {
      return signedIn() && (
        isAdmin() || profileName() == 'Rinze' || profileName() == 'Christa'
      );
    }

    match /appAdmin/settings {
      allow read: if isInvited() || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /appData/hogeterpjes {
      allow read, write: if isInvited() || isAdmin();
    }
    match /profielen/{userId} {
      allow read: if signedIn() && ((request.auth.uid == userId && (isInvited() || isAdmin())) || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId && (isInvited() || isAdmin());
    }
    match /vaults/rinze-christa {
      allow read: if isRinzeOrChrista();
      allow create, update, delete: if isAdmin();
      match /files/{fileId} {
        allow read, create, update, delete: if isRinzeOrChrista();
      }
    }
    match /diaries/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
      match /entries/{entryId} {
        allow read, create, update, delete: if isAdmin() && request.auth.uid == userId;
      }
    }
    match /privateGiftIdeas/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId && (isInvited() || isAdmin());
      match /ideas/{ideaId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId && (isInvited() || isAdmin());
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
