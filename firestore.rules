rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'rohogeterp@gmail.com';
    }
    function settings() {
      return get(/databases/$(database)/documents/appAdmin/settings).data;
    }
    function isInvited() {
      return signedIn() && (
        isAdmin() ||
        ('allowedEmails' in settings() && request.auth.token.email in settings().allowedEmails)
      );
    }
    function profileName() {
      return get(/databases/$(database)/documents/profielen/$(request.auth.uid)).data.displayName;
    }
    function isRinzeOrChrista() {
      return signedIn() && (
        isAdmin() || profileName() == 'Rinze' || profileName() == 'Christa'
      );
    }

    // Verify the profile name against invitations that only the admin can edit.
    // A user changing their own profile must not gain access to their surprises.
    function purchaseName() {
      return isAdmin() ? 'Rinze' : profileName();
    }
    function purchaseMember() {
      return signedIn() && (isAdmin() || (isInvited() && (
        {'name': profileName(), 'email': request.auth.token.email, 'active': true} in settings().accounts ||
        {'name': profileName(), 'email': request.auth.token.email} in settings().accounts
      )));
    }
    function purchaseViewer(person) {
      return purchaseMember() && purchaseName() != person;
    }
    function purchaseStatus(person, wishId) {
      return /databases/$(database)/documents/wishPurchases/$(person)/statuses/$(wishId);
    }
    function purchaseLock(person, wishId) {
      return /databases/$(database)/documents/wishPurchases/$(person)/locks/$(wishId);
    }
    function purchaseClaim(person, wishId) {
      return /databases/$(database)/documents/wishPurchaseClaims/$(request.auth.uid)/items/$(person + '|' + wishId);
    }
    function validPurchaseAfter(person, wishId) {
      let status = getAfter(purchaseStatus(person, wishId)).data;
      let lock = getAfter(purchaseLock(person, wishId)).data;
      let claim = getAfter(purchaseClaim(person, wishId)).data;
      return status.keys().hasOnly(['status']) && status.status in ['reserved', 'bought'] &&
        lock.keys().hasOnly(['buyerUid']) && lock.buyerUid == request.auth.uid &&
        claim.keys().hasOnly(['person', 'wishId', 'status']) &&
        claim.person == person && claim.wishId == wishId && claim.status == status.status;
    }
    function purchaseReleased(person, wishId) {
      return !existsAfter(purchaseStatus(person, wishId)) &&
        !existsAfter(purchaseLock(person, wishId)) && !existsAfter(purchaseClaim(person, wishId));
    }
    match /wishPurchases/{person}/statuses/{wishId} {
      allow read: if purchaseViewer(person);
      allow create: if purchaseViewer(person) && !exists(purchaseLock(person, wishId)) && validPurchaseAfter(person, wishId);
      allow update: if purchaseViewer(person) && get(purchaseLock(person, wishId)).data.buyerUid == request.auth.uid && validPurchaseAfter(person, wishId);
      allow delete: if purchaseViewer(person) && get(purchaseLock(person, wishId)).data.buyerUid == request.auth.uid && purchaseReleased(person, wishId);
    }
    match /wishPurchases/{person}/locks/{wishId} {
      allow get: if purchaseViewer(person) && (!exists(purchaseLock(person, wishId)) || resource.data.buyerUid == request.auth.uid);
      allow list: if false;
      allow create: if purchaseViewer(person) && !exists(purchaseStatus(person, wishId)) && validPurchaseAfter(person, wishId);
      allow update: if purchaseViewer(person) && resource.data.buyerUid == request.auth.uid && validPurchaseAfter(person, wishId);
      allow delete: if purchaseViewer(person) && resource.data.buyerUid == request.auth.uid && purchaseReleased(person, wishId);
    }
    match /wishPurchaseClaims/{userId}/items/{claimId} {
      allow read: if purchaseMember() && request.auth.uid == userId;
      allow create, update: if purchaseMember() && request.auth.uid == userId &&
        claimId == request.resource.data.person + '|' + request.resource.data.wishId &&
        purchaseViewer(request.resource.data.person) &&
        validPurchaseAfter(request.resource.data.person, request.resource.data.wishId);
      allow delete: if purchaseMember() && request.auth.uid == userId &&
        purchaseViewer(resource.data.person) && purchaseReleased(resource.data.person, resource.data.wishId);
    }

    match /appAdmin/settings {
      allow read: if isAdmin() || isInvited();
      allow create, update, delete: if isAdmin();
    }
    match /appData/hogeterpjes {
      allow read, write: if isAdmin() || isInvited();
    }

    match /sharedWeekMenus/{mealId} {
      allow read, create, update, delete: if isAdmin() || isInvited();
    }
    match /sharedAgendaEvents/{eventId} {
      allow read, create, update, delete: if isAdmin() || isInvited();
    }
    match /appChangeLog/{changeId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isInvited();
      allow update, delete: if false;
    }
    match /profielen/{userId} {
      allow read: if signedIn() && ((request.auth.uid == userId && (isAdmin() || isInvited())) || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId && (isAdmin() || isInvited());
    }
    // v1.3.41: camping- en boekenideeën zijn uitsluitend voor Rinze en Christa.
    match /privateCoupleIdeas/rinze-christa {
      allow read, create, update, delete: if isRinzeOrChrista();
    }

    match /vaults/rinze-christa {
      allow read: if isRinzeOrChrista();
      allow create, update, delete: if isAdmin();
      match /files/{fileId} {
        allow read, create, update, delete: if isRinzeOrChrista();
      }
      match /folders/{folderId} {
        allow read, create, update, delete: if isRinzeOrChrista();
      }
    }
    match /diaries/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
      match /entries/{entryId} {
        allow read, create, update, delete: if isAdmin() && request.auth.uid == userId;
      }
    }
    match /privateGiftIdeas/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId && (isAdmin() || isInvited());
      match /ideas/{ideaId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId && (isAdmin() || isInvited());
      }
    }
    // v1.3.41: persoonlijke to-do's zijn uitsluitend toegankelijk voor de eigenaar.
    // Deze toegang is bewust niet afhankelijk van appAdmin/settings, zodat een
    // storing of ontbrekend allowedEmails-veld de eigen to-do's niet blokkeert.
    match /privateTodos/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      match /items/{todoId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
