rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'rohogeterp@gmail.com';
    }
    function isInvited() {
      return signedIn() && request.auth.token.email in firestore.get(/databases/(default)/documents/appAdmin/settings).data.allowedEmails;
    }
    function profileName() {
      return firestore.get(/databases/(default)/documents/profielen/$(request.auth.uid)).data.displayName;
    }
    function vaultMember() {
      return signedIn() && (
        isAdmin() || profileName() == 'Rinze' || profileName() == 'Christa'
      );
    }

    match /vaults/rinze-christa/{allPaths=**} {
      allow read, delete: if vaultMember();
      allow create: if vaultMember()
        && request.resource.size <= 100 * 1024 * 1024;
      allow update: if false;
    }

    match /diaries/{userId}/{allPaths=**} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
    }

    // v1.3.37: gedeelde foto's staan voortaan in Storage en niet meer
    // als grote base64-tekst in appData/hogeterpjes.
    match /shared-media/{allPaths=**} {
      allow read: if isInvited() || isAdmin();
      allow create: if (isInvited() || isAdmin())
        && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if isInvited() || isAdmin();
    }

    match /{allPaths=**} {
      // Alleen Rinze (admin) mag de bucket-lijst opvragen
      // om het totale opslaggebruik op Home te berekenen.
      allow list: if isAdmin();
      allow get, create, update, delete: if false;
    }
  }
}
