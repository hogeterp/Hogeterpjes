rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'rohogeterp@gmail.com';
    }
    function profileName() {
      return firestore.get(/databases/(default)/documents/profielen/$(request.auth.uid)).data.displayName;
    }
    function vaultMember() {
      return signedIn() && (
        isAdmin() || profileName() == 'Rinze' || profileName() == 'Christa'
      );
    }

    match /vaults/rinze-christa/{allPaths=**} {
      allow read, delete: if vaultMember();
      allow create: if vaultMember()
        && request.resource.size <= 100 * 1024 * 1024;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
