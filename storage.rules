rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rohogeterp@gmail.com';
    }
    function isChrista() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/profielen/$(request.auth.uid)).data.displayName == 'Christa';
    }
    function vaultMember() {
      return isAdmin() || isChrista();
    }

    match /vaults/rinze-christa/{allPaths=**} {
      allow read, delete: if vaultMember();
      allow create: if vaultMember()
        && request.resource.size <= 100 * 1024 * 1024;
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
